---
import { openSourceProjects } from "../lib/projects";
---

<div class="flex flex-col gap-6">
	<h2 class="text-xl font-bold text-white">
		Open-source projects
	</h2>

	<article class="mb-6">
		<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
			{
				openSourceProjects.map((project) => (
					<a
						href={project.repoLink}
						class="flex justify-center flex-col px-3 py-3 border rounded-sm border-gray-800 hover:bg-gray-800"
					>
						<h3 class="font-bold text-white">{project.title}</h3>
						<p class="text-pretty font-mono mt-2 text-sm text-gray-400">
							{project.description}
						</p>
					</a>
				))
			}
		</div>
	</article>
</div>
