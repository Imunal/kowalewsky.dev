---
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
	.sort((a, b) => Date.parse(b.data.date) - Date.parse(a.data.date))
	.slice(0, 3);

const formatDate = (date: string) =>
	new Date(date).toLocaleDateString("en-GB", {
		day: "numeric",
		month: "long",
		year: "numeric",
		timeZone: "UTC",
	});
---

{posts.length > 0 && (
	<section aria-labelledby="latest-posts-title" class="my-10 border-b border-gray-800 pb-10">
		<div class="mb-2 flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
			<h2 id="latest-posts-title" class="text-xl font-bold text-white">Latest posts</h2>
			<a
				href="/blog/"
				data-astro-prefetch
				class="inline-flex min-h-11 items-center gap-2 text-sm text-gray-300 underline-offset-4 hover:text-white hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
			>
				View all posts
				<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
					<path d="M5 12h14m-6-6 6 6-6 6" />
				</svg>
			</a>
		</div>
		<ul class="divide-y divide-gray-800">
			{posts.map((post) => (
				<li>
					<article>
						<a
							href={`/blog/${post.id}/`}
							data-astro-prefetch
							class="group grid gap-3 py-6 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white md:grid-cols-[9rem_minmax(0,1fr)] md:gap-6"
						>
							<time datetime={post.data.date} class="font-mono text-xs leading-6 text-gray-400">
								{formatDate(post.data.date)}
							</time>
							<div>
								<h3 class="text-lg font-semibold leading-snug text-white underline-offset-4 group-hover:underline group-focus-visible:underline">
									{post.data.title}
								</h3>
								<p class="mt-3 max-w-prose font-mono text-sm leading-relaxed text-gray-400">
									{post.data.description}
								</p>
							</div>
						</a>
					</article>
				</li>
			))}
		</ul>
	</section>
)}
